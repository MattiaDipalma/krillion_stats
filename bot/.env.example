# Copia questo file in .env e completalo.

# Nome esatto del gruppo WhatsApp da leggere
GROUP_NAME=Krillion Daily
# In alternativa l'id del gruppo (il bot lo stampa all'avvio se non trova il nome)
# GROUP_JID=120363000000000000@g.us

# Il tuo nome nelle statistiche (su WhatsApp i tuoi messaggi risultano "Tu")
MY_NAME=Mattia

# Token GitHub (fine-grained, permesso "Contents: Read and write" solo su questo repo).
# Senza token il bot scrive solo il file locale ../docs/data/stats.json
GITHUB_TOKEN=
GITHUB_REPO=MattiaDipalma/krillion_stats
GITHUB_BRANCH=main
# STATS_PATH=docs/data/stats.json

# Fuso orario usato per la data dei messaggi
TIMEZONE=Europe/Zurich

# Secondi di attesa prima di salvare: i risultati arrivati nel frattempo
# finiscono in un solo commit
FLUSH_DELAY_SECONDS=60

# Collegamento con codice invece che con il QR (utile su un server senza schermo):
# numero di telefono con prefisso internazionale, solo cifre
# PAIRING_PHONE=41791234567

# Livello di log di Baileys (error, warn, info, debug)
# LOG_LEVEL=error
